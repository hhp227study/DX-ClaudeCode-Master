# Supabase 연결 정보 (실제 값은 .env.local에 작성)
# Supabase 대시보드 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 프로필 이미지 공개 URL의 앞부분 (스토리지 주소 ~ 버킷명, 끝에 / 없이)
# 뒷부분(버킷명 이후 파일 경로)은 profile.image_path 컬럼에 저장된다
NEXT_PUBLIC_PROFILE_IMAGE_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/profile-image
